# GoHighLevel (Settings > Private Integrations). Token starts with pit-. Scopes are listed in docs/setup.md.
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
# IDs of the two text custom fields "Review Request Sent" and "Review Reminder Sent" (docs/setup.md shows the API call).
# n8n writes the send times into them, and the weekly digest counts from them.
GHL_FIELD_REQUEST_SENT_ID=your-review-request-sent-field-id
GHL_FIELD_REMINDER_SENT_ID=your-review-reminder-sent-field-id
# Optional: the user who gets the service recovery tasks and owns the notes. Empty: tasks are not assigned.
GHL_OWNER_USER_ID=
# Optional: the number replies go out from. Leave empty to use the location's default number.
GHL_FROM_NUMBER=
# Optional: your white label app domain, used for contact links in Slack
GHL_APP_URL=https://app.gohighlevel.com

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. claude-haiku-4-5 is cheaper. The workflow forces a tool call with thinking off,
# so claude-opus-5-5 and the Claude Fable and Mythos models do not work (the workflow refuses to start with them).
ANTHROPIC_MODEL=claude-sonnet-5

# Shared secret. Make up a long random string. The GoHighLevel workflows send it in the X-Review-Secret header
# (or as customData.secret from the standard Webhook action). The digest webhook uses the same header.
REVIEW_WEBHOOK_SECRET=make-up-a-long-random-string

# The business, as the replies and Claude describe it
BUSINESS_NAME=Summit Roofing Co.
BUSINESS_ABOUT=a roofing contractor
# Who calls an unhappy customer back, as the apology names them ("Mike will call you shortly")
RECOVERY_CALLER=someone from our team

# Quiet hours for SMS replies, in the customer's time zone (BUSINESS_TZ when the contact has none).
# A reply outside this window is scheduled in GoHighLevel for SEND_HOUR_START the next morning.
BUSINESS_TZ=America/Denver
SEND_HOUR_START=8
SEND_HOUR_END=20
# The owner's recovery task is due this many hours after the complaint (moved to the next morning if that is outside the window)
TASK_DUE_HOURS=4
# Assistant messages per customer before a person takes over
MAX_AI_REPLIES=2
# Replies more than this many days after the review request are left alone (STOP is honored at any time)
REPLY_WINDOW_DAYS=30
# Prefix of every tag in this build (review-requested, review-needs-recovery, and so on). Must match the GoHighLevel workflows.
TAG_PREFIX=review
# false: an opt out sets DND for the channel the customer used. true: DND for every channel.
DND_ALL_CHANNELS=false

# Slack incoming webhook for the owner alerts, the weekly digest and the error alerts. Required: without it complaints
# and questions would reach nobody, so the workflow refuses to run.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# The weekly digest runs Mondays at 8 AM (the workflow's time zone). false turns it off.
DIGEST_ENABLED=true
# How many contacts one digest looks at: SEARCH_PAGE_SIZE x MAX_SEARCH_PAGES (default 100 x 10)
SEARCH_PAGE_SIZE=100
MAX_SEARCH_PAGES=10

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
